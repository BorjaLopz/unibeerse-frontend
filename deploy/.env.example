# Copia a deploy/.env, rellena y protege con: chmod 600 .env
UNIBEERSE_DB_PASSWORD=la_contraseña_de_unibeerse_user

# Firebase (solo Auth: login). Valores publicos de la web, los mismos de src/components/firebaseConfig.js
FIREBASE_PROJECT_ID=unibeerse-db
VITE_FIREBASE_API_KEY=AIzaSyDe-vhUew0LF32bYnoXPa2xLsEvSfyOr4k
VITE_FIREBASE_AUTH_DOMAIN=unibeerse-db.firebaseapp.com
VITE_FIREBASE_APP_ID=1:734269366757:web:37ba5872bc66b31aa50f0c

# Tu uid de Firebase (Firebase Console > Authentication > Usuarios). Varios: separados por comas
ADMIN_UIDS=

# Clave de autenticacion de Tailscale para el contenedor publico (ver README, seccion 3)
TS_AUTHKEY=

# Opcional: avisos por Telegram cuando alguien escribe desde el formulario de contacto.
# Puedes reutilizar el bot "NUC Avisos" (mismos valores que ~/backups/.telegram). Vacio = desactivado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bot de Telegram de Unibeerse (añadir cervezas con foto, cambiar fotos, puntuar) ---
# Crea un bot NUEVO con @BotFather (distinto del de avisos y del de Ledger) y pega aqui su token
UNIBEERSE_BOT_TOKEN=
# Tu ID numerico de Telegram (el mismo que ALLOWED_TELEGRAM_ID de Ledger). Solo a ti te responde.
ALLOWED_TELEGRAM_ID=
# Clave entre el bot y la API (minimo 32 caracteres). Genera una con: openssl rand -hex 32
BOT_API_KEY=
